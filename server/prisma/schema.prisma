generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ESTIMATOR
  SALES_HEAD
  PLANT_HEAD
  ADMIN
}

enum RFQStatus {
  RECEIVED
  ESTIMATING
  PENDING_APPROVAL
  QUOTATION_SENT
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  WON
  LOST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CostComponentType {
  MATERIAL
  MACHINING
  SCRAP
  OVERHEAD
  PACKING
  FREIGHT
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ESTIMATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedRFQs RFQ[]      @relation("AssignedEstimator")
  createdRFQs  RFQ[]      @relation("CreatedRFQs")
  quotations   Quotation[]
  costings     Costing[]
  approvals    Approval[]
  attachments  Attachment[]
  auditLogs    AuditLog[]

  @@index([role])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  email       String?
  phone       String?
  address     String?
  gstNumber   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rfqs        RFQ[]
  quotations Quotation[]

  @@index([name])
}

model RFQ {
  id             String    @id @default(cuid())
  rfqNumber      String    @unique
  customerId     String
  createdById    String
  assignedToId   String?
  receivedDate   DateTime  @default(now())
  dueDate        DateTime?
  status         RFQStatus @default(RECEIVED)
  lostReason     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer       Customer  @relation(fields: [customerId], references: [id])
  createdBy      User      @relation("CreatedRFQs", fields: [createdById], references: [id])
  assignedTo     User?     @relation("AssignedEstimator", fields: [assignedToId], references: [id])
  parts          Part[]
  attachments    Attachment[]
  quotations     Quotation[]
  extractionJobs ExtractionJob[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([receivedDate])
}

model Part {
  id             String   @id @default(cuid())
  rfqId          String
  partNumber     String?
  name           String
  description    String?
  materialGrade  String?
  grossWeightKg  Decimal? @db.Decimal(12, 4)
  annualVolume   Int?
  drawingNumber  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rfq             RFQ          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  materialRate    MaterialRate? @relation("PartMaterialRate", fields: [materialRateId], references: [id])
  materialRateId  String?
  routing         Routing?
  costings        Costing[]
  quotationParts  QuotationPart[]
  attachments     Attachment[]

  @@index([rfqId])
  @@index([partNumber])
  @@index([name])
  @@index([materialGrade])
}

model MaterialRate {
  id          String   @id @default(cuid())
  materialCode String
  materialName String
  grade       String
  ratePerKg   Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  parts       Part[]    @relation("PartMaterialRate")
  costings    Costing[]

  @@unique([materialCode, effectiveFrom])
  @@index([grade, isActive])
}

model MachineRate {
  id             String   @id @default(cuid())
  machineCode    String
  machineName    String
  ratePerHour    Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  operations     RoutingOperation[]

  @@unique([machineCode, effectiveFrom])
  @@index([machineCode, isActive])
}

model Routing {
  id        String   @id @default(cuid())
  partId    String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  part       Part               @relation(fields: [partId], references: [id], onDelete: Cascade)
  operations RoutingOperation[]
}

model RoutingOperation {
  id             String   @id @default(cuid())
  routingId      String
  sequence       Int
  operationName  String
  machineRateId  String?
  cycleTimeMin   Decimal  @db.Decimal(12, 4)
  setupTimeMin   Decimal? @db.Decimal(12, 4)
  createdAt      DateTime @default(now())

  routing        Routing      @relation(fields: [routingId], references: [id], onDelete: Cascade)
  machineRate    MachineRate? @relation(fields: [machineRateId], references: [id])

  @@unique([routingId, sequence])
  @@index([machineRateId])
}

model Costing {
  id              String   @id @default(cuid())
  partId          String
  materialRateId  String?
  createdById     String
  version         Int      @default(1)
  grossWeightKg   Decimal  @db.Decimal(12, 4)
  scrapPercentage Decimal  @default(0) @db.Decimal(8, 4)
  overheadAmount  Decimal  @default(0) @db.Decimal(14, 2)
  packingAmount   Decimal  @default(0) @db.Decimal(14, 2)
  freightAmount   Decimal  @default(0) @db.Decimal(14, 2)
  profitMargin    Decimal  @default(0) @db.Decimal(8, 4)
  totalCost       Decimal  @db.Decimal(14, 2)
  assumptions     String?
  createdAt       DateTime @default(now())

  part            Part          @relation(fields: [partId], references: [id], onDelete: Cascade)
  materialRate    MaterialRate? @relation(fields: [materialRateId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])
  volumes         CostingVolume[]
  components      CostComponent[]
  quotationParts  QuotationPart[]

  @@index([partId, version])
}

model CostingVolume {
  id                String   @id @default(cuid())
  costingId         String
  annualVolume      Int
  totalCost         Decimal  @db.Decimal(14, 2)
  unitPrice         Decimal  @db.Decimal(14, 2)
  createdAt         DateTime @default(now())

  costing           Costing  @relation(fields: [costingId], references: [id], onDelete: Cascade)

  @@unique([costingId, annualVolume])
}

model CostComponent {
  id          String             @id @default(cuid())
  costingId   String
  type        CostComponentType
  name        String
  amount      Decimal            @db.Decimal(14, 2)
  description String?

  costing     Costing            @relation(fields: [costingId], references: [id], onDelete: Cascade)

  @@index([costingId])
}

model Quotation {
  id             String           @id @default(cuid())
  quotationNumber String          @unique
  rfqId          String
  customerId     String
  createdById    String
  status         QuotationStatus  @default(DRAFT)
  validUntil     DateTime?
  gstPercentage Decimal           @default(18) @db.Decimal(8, 4)
  subtotal       Decimal           @db.Decimal(14, 2)
  gstAmount      Decimal           @db.Decimal(14, 2)
  grandTotal     Decimal           @db.Decimal(14, 2)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  rfq            RFQ       @relation(fields: [rfqId], references: [id])
  customer       Customer  @relation(fields: [customerId], references: [id])
  createdBy      User      @relation(fields: [createdById], references: [id])
  parts          QuotationPart[]
  approvals      Approval[]

  @@index([rfqId])
  @@index([customerId])
  @@index([status])
}

model QuotationPart {
  id            String   @id @default(cuid())
  quotationId   String
  partId        String
  costingId     String?
  quantity      Int
  unitPrice     Decimal  @db.Decimal(14, 2)
  totalPrice    Decimal  @db.Decimal(14, 2)

  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  part          Part      @relation(fields: [partId], references: [id])
  costing       Costing?  @relation(fields: [costingId], references: [id])

  @@index([quotationId])
  @@index([partId])
}

model Approval {
  id           String         @id @default(cuid())
  quotationId  String
  approverId   String
  status       ApprovalStatus @default(PENDING)
  comments     String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())

  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approver     User      @relation(fields: [approverId], references: [id])

  @@index([quotationId, status])
  @@index([approverId])
}

model Attachment {
  id           String   @id @default(cuid())
  rfqId        String?
  partId       String?
  uploadedById String
  fileName     String
  storagePath  String
  mimeType     String
  fileSize     Int
  createdAt    DateTime @default(now())

  rfq          RFQ?  @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  part         Part? @relation(fields: [partId], references: [id], onDelete: Cascade)
  uploadedBy   User  @relation(fields: [uploadedById], references: [id])

  extractionJobs ExtractionJob[]

  @@index([rfqId])
  @@index([partId])
}

model ExtractionJob {
  id           String           @id @default(cuid())
  rfqId        String
  attachmentId String
  status       ExtractionStatus @default(PENDING)
  provider     String?
  errorMessage String?
  createdAt    DateTime         @default(now())
  completedAt  DateTime?

  rfq          RFQ        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  fields       ExtractedField[]

  @@index([rfqId, status])
}

model ExtractedField {
  id             String   @id @default(cuid())
  extractionJobId String
  fieldName      String
  extractedValue String
  confidence     Decimal? @db.Decimal(5, 4)
  sourceReference String?
  acceptedValue  String?
  isAccepted     Boolean  @default(false)
  createdAt      DateTime @default(now())

  extractionJob  ExtractionJob @relation(fields: [extractionJobId], references: [id], onDelete: Cascade)

  @@index([extractionJobId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor      User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
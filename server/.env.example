# Required service configuration
DATABASE_URL=postgresql://rfq_app:replace-with-password@127.0.0.1:5432/forgeflow_dev
JWT_SECRET=replace-with-a-long-random-secret

# HTTP configuration
PORT=5000
# Production requires an HTTPS browser origin. Local development may use localhost.
CLIENT_URL=http://localhost:5173
# Number of reverse-proxy hops trusted to supply the real client IP. Production requires 1-5.
TRUST_PROXY_HOPS=1

# Local-only storage defaults to the private filesystem. For ephemeral cloud
# instances, select a private object-storage provider such as Cloudflare R2.
RFQ_DOCUMENT_STORAGE_PROVIDER=local
RFQ_DOCUMENT_STORAGE_DIR=/absolute/path/to/private/forgeflow-documents
# Required only when RFQ_DOCUMENT_STORAGE_PROVIDER=r2. Create a private bucket
# and a bucket-scoped object read/write token in the provider dashboard; never
# expose these credentials to Vite or put real values in this file.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# AI is disabled by default in production unless set to true. The default endpoint is local Ollama.
LOCAL_AI_ENABLED=false
# For local inference, use a locally installed model such as qwen2.5:1.5b.
OLLAMA_RFQ_MODEL=qwen2.5:1.5b
# Remote Ollama-compatible endpoints must use HTTPS. Do not send customer RFQ text externally
# without Company A's data-processing approval. For Ollama Cloud, set this to https://ollama.com
# and place the API key in the backend secret manager (never in frontend configuration).
OLLAMA_RFQ_BASE_URL=http://127.0.0.1:11434
# Optional; required when production AI is enabled with a remote endpoint.
# OLLAMA_API_KEY=
# CPU-only inference is the verified WSL mode. Set 0 for CPU; valid range is 0-128 GPU layers.
OLLAMA_RFQ_NUM_GPU=0
# CPU thread limit; 4 avoids oversubscribing small WSL/VM hosts while preserving model output settings.
OLLAMA_RFQ_NUM_THREAD=4
# Total cold-load plus prompt/generation timeout. Valid range: 90000-600000 milliseconds.
OLLAMA_RFQ_TIMEOUT_MS=180000
# Keep the model warm briefly between nearby intake requests; valid range is 0-10m.
OLLAMA_RFQ_KEEP_ALIVE=2m

# Optional first-run account bootstrap for `npm run db:seed` in server/.
# Set privately; do not use these example values as credentials.
BOOTSTRAP_ADMIN_NAME=Local Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-private-password-at-least-12-characters

# Optional Sales Head bootstrap. Omit all three to skip this account.
SALES_HEAD_NAME=Local Sales Head
SALES_HEAD_EMAIL=sales-head@example.invalid
SALES_HEAD_PASSWORD=replace-with-a-private-password-at-least-12-characters
